# Copy to .env and fill in real values. Do not commit .env.
#
#   cp .env.example .env
#
# --- Database (used by docker compose to provision Postgres) ---
POSTGRES_USER=barista
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=barista_db

# SQLAlchemy / Alembic connection string.
# Local (host)     : postgresql+psycopg2://barista:change-me-strong-password@localhost:5434/barista_db
# Inside compose   : postgresql+psycopg2://barista:change-me-strong-password@db:5432/barista_db
DATABASE_URL=postgresql+psycopg2://barista:change-me-strong-password@localhost:5434/barista_db

# --- Google Gemini ---
# Create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Web server (optional) ---
# Interface to bind. Defaults to 127.0.0.1 (localhost only). Set 0.0.0.0 to expose.
WCDA_HOST=127.0.0.1
# Port the app listens on inside the container / process.
WEB_PORT=8080
# Directory where uploaded coffee-bag photos are stored.
LOG_IMAGES_DIR=./data/log_images

# --- Multi-user (optional) ---
# WCDA_AUTH_MODE decides which user a request's data is scoped to (see
# src/core/auth.py):
#   single    : every request belongs to one implicit owner (the dev instance).
#   tailscale : owner is the Tailscale-User-Login header that `tailscale serve`
#               forwards. Only safe when the app is reachable ONLY via Serve
#               (bound to loopback) -- otherwise the header can be spoofed.
# Leave this UNSET here: compose.yaml already defaults it to `single` and
# compose.prod.yaml to `tailscale`, and a value in .env would override both
# (the two stacks share this file).
# WCDA_AUTH_MODE=single
#
# The owner every request maps to in `single` mode -- also the identity that
# migration 0005 backfills onto all pre-multi-user rows. Change with care.
# WCDA_SINGLE_USER=owner
# Optional comma-separated override for the Gemini model fallback list, tried
# in order. Default leads with gemini-3.8-flash and falls back through 3.7,
# 3.5 and the 2.5 pair. Every name must exist: the chain stops on a
# non-transient error rather than skipping past a model that 404s.
# WCDA_GEMINI_MODELS=gemini-3.8-flash,gemini-2.5-flash
# Extended-reasoning level for Gemini 3.x calls: high | low | off.
# Both call sites (bag OCR, rationale prose) default to "low" because the user
# is waiting on each. Older models never receive the parameter.
# WCDA_GEMINI_THINKING=high

# --- AI spending limits (optional) ---
# The Gemini key is one shared credential with a daily ceiling, so every
# billable call is counted per owner per calendar month (see src/core/quota.py).
#
# Two kinds, and they fail differently on purpose. A bag scan ("vision") has no
# non-AI fallback, so over quota it returns 429. The prose around a recipe
# ("rationale") has a deterministic template, so over quota it silently uses
# that -- the numbers are identical either way, because the engine fixes every
# one of them.
#
# `single` mode is never metered: that instance is your own machine using your
# own key. Everywhere else, these apply.
#
# A negative value means unlimited. Zero means the call is never made.
# WCDA_FREE_SCANS_PER_MONTH=5
# WCDA_PAID_SCANS_PER_MONTH=100
# WCDA_FREE_PROSE_PER_MONTH=0
# WCDA_PAID_PROSE_PER_MONTH=-1
#
# Who is on the paid tier, comma-separated, matched case-insensitively against
# the resolved owner. This is a placeholder for a real subscription lookup.
# NOTE: on the friends instance, anyone NOT listed here drops to the free tier
# the moment this ships -- they keep every recipe and every shot, but their
# explanations become the deterministic template and they get 5 scans a month.
# List them here to leave them as they were.
# WCDA_ENTITLED_OWNERS=friend@example.com,other@example.com
#
# How many cached explanations to keep per owner before the oldest are dropped.
# WCDA_RATIONALE_CACHE_PER_OWNER=200

# ── Admin dashboard (dev instance only) ──────────────────────────────────────
# Set both to give the dev stack a read-only view of the friends database at
# /admin, and bring it up with the overlay:
#   docker compose -f compose.yaml -f compose.admin.yaml up -d --build
# Create the role first with scripts/create_readonly_role.sql.
# Leave both empty on the friends instance -- the routes are then never mounted.
WCDA_ADMIN_DATABASE_URL=postgresql+psycopg2://wcda_readonly:CHANGEME@wcda-prod-db-1:5432/barista_db
WCDA_ADMIN_TOKEN=
